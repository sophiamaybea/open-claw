# Dedicated OpenClaw Supabase project. Never commit the real values.
OPENCLAW_SUPABASE_URL=
OPENCLAW_SUPABASE_PUBLISHABLE_KEY=

# CLI/runtime sign-in. Prefer injecting these from a secret manager.
OPENCLAW_SUPABASE_EMAIL=
OPENCLAW_SUPABASE_PASSWORD=

# Optional short-lived session values instead of email/password.
OPENCLAW_SUPABASE_ACCESS_TOKEN=
OPENCLAW_SUPABASE_REFRESH_TOKEN=

# Optional, only needed for private GitHub repositories or higher API limits.
GITHUB_TOKEN=
OPENCLAW_GITHUB_REPO=sophiamaybea/open-claw
